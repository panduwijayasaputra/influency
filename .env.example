# Copy to `.env` at the repo root and fill in local values. Placeholders only — never commit real secrets.

# --- Required now (validated by the API at startup) ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://influency:CHANGE_ME@localhost:5432/influency
# Used by `pnpm test`; wiped and re-migrated on every run. Name must end in _test.
TEST_DATABASE_URL=postgresql://influency:CHANGE_ME@localhost:5432/influency_test
# Sandbox only. The API refuses to start if this is true.
MIDTRANS_IS_PRODUCTION=false
# Public web origin (the web app proxies /api/v1 to the API). Use your HTTPS tunnel URL for real Telegram login.
WEB_ORIGIN=http://localhost:3000

# Telegram Login OIDC: BotFather > your bot > Login Widget. Client ID is the numeric Bot ID (placeholder below).
# Register the origin and this redirect URI under Allowed URLs; real Telegram needs an HTTPS tunnel URL, not localhost.
TELEGRAM_OIDC_CLIENT_ID=0000000000
TELEGRAM_OIDC_CLIENT_SECRET=SET_LOCALLY
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/telegram/callback
# Absolute session lifetime in days (default 30); users log in again after it.
SESSION_TTL_DAYS=30
# Proxies whose X-Forwarded-For gives the client IP (rate-limit keys): a hop count (1-5) or comma-separated IPs/CIDRs.
# Unset = trust none (anonymous callers share one bucket). Set it ONLY where the edge (load balancer/CDN) overwrites
# X-Forwarded-For: the Next proxy forwards a client-sent value, so otherwise clients choose their own key. `true` is refused.
# TRUST_PROXY=127.0.0.1,::1

# --- Web app ---
# Where apps/web proxies /api/v1. Next.js does not read this root .env (it must not hold API secrets),
# so set API_ORIGIN in the shell/deploy env of the web app; the default is http://localhost:4000.
API_ORIGIN=http://localhost:4000

# --- Not used yet (added to validation by the story that needs them) ---
# Redis is deferred until Phase 5 (background jobs)
REDIS_URL=redis://localhost:6379
SESSION_SECRET=SET_LOCALLY_DO_NOT_COMMIT

# Telegram bot (notifications, docs/telegram-bot.md). Leave at SET_LOCALLY (= off) unless you have a BotFather bot;
# when the token is set, the username and webhook secret are required too.
TELEGRAM_BOT_TOKEN=SET_LOCALLY
TELEGRAM_BOT_USERNAME=SET_LOCALLY
TELEGRAM_BOT_WEBHOOK_SECRET=SET_LOCALLY

# Payments: fake (in-process, development/test only) or midtrans (Snap Sandbox; needs the keys below).
# Midtrans notifications need a public HTTPS tunnel/staging URL; without one, opening the top-up status page still credits via a status check.
PAYMENT_PROVIDER=fake
MIDTRANS_SERVER_KEY=SANDBOX_KEY_ONLY
MIDTRANS_CLIENT_KEY=SANDBOX_KEY_ONLY
MIDTRANS_MERCHANT_ID=SET_LOCALLY
# Seconds between status checks of pending top-ups (0 = off).
TOPUP_RECONCILE_INTERVAL_SECONDS=60
MIDTRANS_WEBHOOK_URL=https://YOUR_PUBLIC_DEV_URL/webhooks/payments/midtrans

# Notifications (discover-notifications-settings). EXAMPLE: days a notification stays in the inbox.
NOTIFICATION_RETENTION_DAYS=90
# EXAMPLE: at most one new-post notification per creator per follower per this many minutes.
NEW_POST_NOTIFY_WINDOW_MINUTES=60
# EXAMPLE: hours before a subscription period ends that the reminder is created.
SUBSCRIPTION_REMINDER_LEAD_HOURS=72
# Seconds between subscription reminder sweeps (0 = off).
SUBSCRIPTION_REMINDER_INTERVAL_SECONDS=3600

# Object storage for images: local (files under LOCAL_STORAGE_DIR, development only; rejected
# when NODE_ENV=production) or r2 (private Cloudflare R2 bucket, needs the R2_* values below).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
# Lifetime of presigned upload URLs (60-3600 s).
UPLOAD_URL_TTL_SECONDS=300

# Cloudflare R2 (images, only read when STORAGE_DRIVER=r2).
R2_ACCOUNT_ID=SET_LOCALLY
R2_ACCESS_KEY_ID=SET_LOCALLY
R2_SECRET_ACCESS_KEY=SET_LOCALLY
R2_BUCKET=SET_LOCALLY

# Video for posts: stub (kept in the object storage above with simulated processing; development
# only, rejected when NODE_ENV=production) or stream (Cloudflare Stream, needs the values below).
VIDEO_DRIVER=stub
# Lifetime of a video upload slot (120-21600 s).
VIDEO_UPLOAD_TTL_SECONDS=1800
# Placeholder (TBD): a video still processing this long after its upload slot expired is marked failed (600-86400 s).
VIDEO_PROCESSING_TIMEOUT_SECONDS=7200
# How often the API marks stale uploads failed and deletes their files/videos (0-3600 s, 0 = off).
MEDIA_SWEEP_INTERVAL_SECONDS=300
# Placeholder (TBD): lifetime of minted media URLs / video playback tokens (600-1800 s).
MEDIA_ACCESS_TTL_SECONDS=1800
# Placeholder (TBD): true sends published posts to PENDING_REVIEW (admin approval) instead of PUBLISHED.
POST_MODERATION_REQUIRED=false
# Placeholder (TBD): true shows a dedicated uploaded premium cover unblurred to the public; post media stays blurred.
PREMIUM_COVER_CLEAR_ALLOWED=false
# Placeholder (TBD): true lets logged-in users like premium posts they have not unlocked.
PREMIUM_LIKES_WITHOUT_ACCESS=false
# Placeholder (TBD): true lets logged-in users read / write comments on premium posts they have not unlocked.
PREMIUM_COMMENTS_READ_WITHOUT_ACCESS=false
PREMIUM_COMMENTS_WRITE_WITHOUT_ACCESS=false
# Payout account numbers are encrypted at rest with this key: base64 of exactly 32 random bytes. Generate your own:
#   openssl rand -base64 32
# Required. Losing it makes stored account numbers unreadable, so keep a backup. Never commit a real one.
PAYOUT_ACCOUNT_ENC_KEY=SET_LOCALLY
# Placeholder (TBD, EXAMPLE value): bank transfer fee of a payout in whole rupiah (borne by the creator, shown before they
# confirm). The real cost is OPEN; keep it below the Rp100.000 minimum withdrawal.
PAYOUT_TRANSFER_FEE_IDR=2500
# Placeholder (TBD): true once the fee above is the confirmed real cost; while false the UI labels it "Perlu konfirmasi".
PAYOUT_TRANSFER_FEE_CONFIRMED=false
# Placeholder (TBD): comments one user may create per rolling minute.
COMMENT_RATE_LIMIT_PER_MINUTE=10
# Cloudflare Stream (only read when VIDEO_DRIVER=stream): account ID + API token with Stream Write.
CLOUDFLARE_STREAM_ACCOUNT_ID=SET_LOCALLY
CLOUDFLARE_STREAM_TOKEN=SET_LOCALLY
# Stream processing webhook secret (see docs/video-processing.md). Leave unset to rely on polling; any value enables
# POST /api/v1/webhooks/video/cloudflare-stream, so never put a placeholder here.
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=
